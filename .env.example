# hermes-x-bookmarks: settings for the Hermes profile's .env
# Copy the lines you need into your Hermes .env (Windows: %LOCALAPPDATA%\hermes\.env,
# Linux/macOS: ~/.hermes/.env) and fill in the values. Never commit real values.

# X sign-in, option 1 (simplest, no browser sign-in): your own X developer app,
# Keys and tokens page. App permissions: Read. Generate the Access Token AFTER setting
# the permission, so the token is read-only.
XBM_X_API_KEY=
XBM_X_API_SECRET=
XBM_X_ACCESS_TOKEN=
XBM_X_ACCESS_TOKEN_SECRET=

# X sign-in, option 2: OAuth 2.0 through Hermes
# (Native App, then `hermes auth add hermes-x-bookmarks:x`). Leave empty when you use option 1.
XBM_X_CLIENT_ID=

# Later: Notion export (internal integration token) and Google Docs export (Desktop OAuth client).
# XBM_NOTION_TOKEN=
# XBM_GOOGLE_CLIENT_ID=
# XBM_GOOGLE_CLIENT_SECRET=
